# Copy this file to `.env` and fill in the API keys for the providers you use.
# Load it into your shell before running (e.g. `export $(grep -v '^#' .env | xargs)`
# or `set -a; source .env; set +a`). The code reads these via os.environ.

# OpenAI (GPT-4.1 / GPT-5.x). Used for table title & primary-key extraction and
# for any gpt-* evaluation model.
openai_api_key=

# Google Gemini (gemini-* evaluation models).
gemini_api_key=

# Anthropic Claude (claude-* evaluation models, e.g. Opus 4.8).
claude_api=

# Hugging Face Inference API (open-weight models, e.g. Llama 3.3 70B).
hf_api=
